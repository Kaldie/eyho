DATABASE_URL=postgres://localhost:5432/eyho?sslmode=disable
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PORT=8080

# --- Accounts & sign-in (feature 001) ---
# local | demo | production. Anything else (or unset) is treated as production: the backend then
# refuses DEMO_AUTH_ENABLED, KVK_MODE other than "kvk", and an issuer that is not the Auth0 tenant.
APP_ENV=local
# Token issuer and the eyho API identifier (audience). Locally: the mock-oidc service.
OIDC_ISSUER=http://localhost:8081/eyho
OIDC_AUDIENCE=eyho-api
# Optional: reach the issuer at another address (Docker: http://mock-oidc:8081/eyho) while keeping
# the issuer URL above as the token `iss`.
# OIDC_DISCOVERY_URL=
# One-tap demo accounts (/api/v1/demo/*). Only allowed when APP_ENV is demo or local.
DEMO_AUTH_ENABLED=true
# Auth0 Management API (resend verification email, delete users). Leave empty locally.
# Production: AUTH0_MGMT_DOMAIN must equal the host of OIDC_ISSUER (https://<domain>/).
AUTH0_MGMT_DOMAIN=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Business register: kvk (production, paid key), kvk-test (demo, KVK test environment), fake (local).
KVK_MODE=fake
KVK_API_KEY=
# How long a deleted account's identity is remembered so its old tokens cannot re-create the
# account (Go duration, default 24h). Also the maximum token age: tokens issued longer ago are
# refused (401) whatever their expiry, so the frontend must renew tokens within this window.
# TOMBSTONE_RETENTION=24h
